set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(ARM_GCC_ROOT "G:/arm-gcc" CACHE PATH "Root directory of GNU Arm Embedded GCC toolchain")

if(WIN32)
    set(TOOLCHAIN_EXT ".exe")
else()
    set(TOOLCHAIN_EXT "")
endif()

set(TOOLCHAIN_PREFIX "${ARM_GCC_ROOT}/bin/arm-none-eabi" CACHE STRING "gnu arm embedded toolchain prefix")

set(CMAKE_C_COMPILER "${TOOLCHAIN_PREFIX}-gcc${TOOLCHAIN_EXT}" CACHE FILEPATH "C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_PREFIX}-g++${TOOLCHAIN_EXT}" CACHE FILEPATH "C++ compiler" FORCE)
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_PREFIX}-gcc${TOOLCHAIN_EXT}" CACHE FILEPATH "ASM compiler" FORCE)
set(CMAKE_LINKER "${TOOLCHAIN_PREFIX}-ld${TOOLCHAIN_EXT}" CACHE FILEPATH "Linker executable" FORCE)
set(CMAKE_AR "${TOOLCHAIN_PREFIX}-ar${TOOLCHAIN_EXT}" CACHE FILEPATH "archiver executable" FORCE)
set(CMAKE_OBJCOPY "${TOOLCHAIN_PREFIX}-objcopy${TOOLCHAIN_EXT}" CACHE FILEPATH "objcopy executable" FORCE)
set(CMAKE_OBJDUMP "${TOOLCHAIN_PREFIX}-objdump${TOOLCHAIN_EXT}" CACHE FILEPATH "objdump executable" FORCE)
set(CMAKE_NM "${TOOLCHAIN_PREFIX}-nm${TOOLCHAIN_EXT}" CACHE FILEPATH "nm executable" FORCE)
set(CMAKE_READELF "${TOOLCHAIN_PREFIX}-readelf${TOOLCHAIN_EXT}" CACHE FILEPATH "readelf executable" FORCE)
set(CMAKE_SIZE "${TOOLCHAIN_PREFIX}-size${TOOLCHAIN_EXT}" CACHE FILEPATH "size executable" FORCE)
set(CMAKE_RANLIB "${TOOLCHAIN_PREFIX}-ranlib${TOOLCHAIN_EXT}" CACHE FILEPATH "ranlib executable" FORCE)
set(CMAKE_STRIP "${TOOLCHAIN_PREFIX}-strip${TOOLCHAIN_EXT}" CACHE FILEPATH "strip executable" FORCE)
